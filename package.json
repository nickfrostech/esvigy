{
   "name": "esvigy-monorepo",
   "private": true,
   "description": "Monorepo for Esvigy illustration library",
   "scripts": {
      "build": "pnpm --filter website build",
      "build:packages": "pnpm --filter \"@esvigy/*\" build",
      "build:all": "pnpm --filter \"@esvigy/*\" build && pnpm --filter website build"
   }
}