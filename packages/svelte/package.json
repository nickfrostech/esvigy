{
   "name": "@esvigy/svelte",
   "version": "0.1.0",
   "description": "Esvigy illustration components for Svelte. 100% vector, tree-shakable, and customizable with micro-animations.",
   "homepage": "https://esvigy.vercel.app",
   "repository": {
      "type": "git",
      "url": "https://github.com/nickfrostech/esvigy.git",
      "directory": "packages/svelte"
   },
   "bugs": {
      "url": "https://github.com/nickfrostech/esvigy/issues"
   },
   "license": "MIT",
   "author": "Nick Frost (https://github.com/nickfrostech)",
   "keywords": [
      "esvigy",
      "illustrations",
      "svg",
      "svelte",
      "svelte5",
      "svelte4",
      "svelte-components",
      "icons",
      "ui",
      "animated",
      "lucide",
      "micro-animations",
      "two-tone",
      "svelte-illustration"
   ],
   "publishConfig": {
      "access": "public"
   },
   "type": "module",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "sideEffects": false,
   "svelte": "./dist/index.js",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "svelte": "./dist/index.js",
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      },
      "./*.svelte": "./src/illustrations/*.svelte",
      "./*": "./src/*"
   },
   "files": [
      "dist",
      "src",
      "README.md",
      "LICENSE"
   ],
   "scripts": {
      "dev": "vite",
      "generate": "tsx scripts/generate.ts",
      "generate:all": "tsx scripts/generate.ts --all",
      "generate:index": "tsx scripts/generate-index.ts",
      "build": "pnpm generate:all && pnpm generate:index && vite build",
      "prepublishOnly": "pnpm build",
      "test": "vitest run",
      "test:watch": "vitest"
   },
   "peerDependencies": {
      "svelte": "^4.0.0 || ^5.0.0"
   },
   "devDependencies": {
      "@sveltejs/vite-plugin-svelte": "^5.0.3",
      "@types/node": "^24.10.0",
      "svelte": "^5.0.0",
      "tsx": "^4.19.0",
      "typescript": "^5.8.0",
      "vite": "^6.0.0",
      "vite-plugin-dts": "^4.5.0",
      "vitest": "^3.0.0"
   }
}
