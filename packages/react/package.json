{
   "name": "@memy/react",
   "version": "0.1.0",
   "description": "Memy illustration components for React",
   "type": "module",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "sideEffects": false,
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      }
   },
   "files": [
      "dist"
   ],
   "scripts": {
      "generate": "tsx scripts/generate.ts",
      "build": "pnpm generate && tsup"
   },
   "peerDependencies": {
      "react": ">=18"
   },
   "devDependencies": {
      "@types/react": "^19.3.0",
      "react": "^19.3.0",
      "tsup": "^8.5.1",
      "tsx": "^4.23.15",
      "typescript": "^5.9.3"
   }
}