{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "lib": [
         "DOM",
         "DOM.Iterable",
         "ESNext"
      ],
      "jsx": "react-jsx",
      "declaration": true,
      "declarationMap": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
   },
   "include": [
      "src/**/*"
   ]
}